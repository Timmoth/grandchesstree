{
  "name": "perft_cpu_2026",
  "version": "main",
  "owner": "ankan-ban",
  "repo": "https://github.com/ankan-ban/perft_cpu_2026",
  "language": "C++",
  "_note": "ankan-ban/perft_cpu_2026 — a perft-only CLI: `perft_cpu <fen> <depth> [-nott|-htt <MB>] [-mt <N>]`. Driven via a bash wrapper that re-spawns the binary per call.",
  "modes": {
    "single-no-cache": {
      "launch": "wrappers/perft_cpu_2026/run.sh -mt 1 -nott",
      "setup": [],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^perft-done$",
      "quit":   "quit"
    },
    "single-with-cache": {
      "launch": "wrappers/perft_cpu_2026/run.sh -mt 1 -htt 4096",
      "setup": [],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^perft-done$",
      "quit":   "quit"
    },
    "multi-no-cache": {
      "launch": "wrappers/perft_cpu_2026/run.sh -mt $(nproc 2>/dev/null || sysctl -n hw.ncpu) -nott",
      "setup": [],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^perft-done$",
      "quit":   "quit"
    },
    "multi-with-cache": {
      "launch": "wrappers/perft_cpu_2026/run.sh -mt $(nproc 2>/dev/null || sysctl -n hw.ncpu) -htt 4096",
      "setup": [],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^perft-done$",
      "quit":   "quit"
    }
  }
}
