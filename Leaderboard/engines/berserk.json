{
  "name": "berserk",
  "version": "13",
  "owner": "jhonnold",
  "repo": "https://github.com/jhonnold/berserk",
  "language": "C",
  "modes": {
    "single-no-cache": {
      "launch": "bin/berserk/src/berserk",
      "setup": [
        "setoption name Threads value 1",
        "setoption name Hash value 1"
      ],
      "case": "position fen {fen}\ngo perft {depth}",
      "end_re": "^Nodes: \\d+$",
      "quit": "quit"
    }
  }
}
