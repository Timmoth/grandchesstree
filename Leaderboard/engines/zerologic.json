{
  "name": "zerologic",
  "version": "1",
  "owner": "0xwurm",
  "repo": "https://github.com/0xwurm/ZeroLogic",
  "language": "C++",
  "_note": "ZeroLogic is single-threaded and only exposes the Hash UCI option — no Threads — so we don't define multi-* modes. Build needs C++23 (gcc >= 13 or clang >= 16) and x86 BMI/BMI2 instructions; will not build on arm64 Mac.",
  "modes": {
    "single-no-cache": {
      "launch": "bin/zerologic/build/ZeroLogic",
      "setup": [
        "setoption name Hash value 1"
      ],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^tt hits:",
      "quit":   "quit"
    },
    "single-with-cache": {
      "launch": "bin/zerologic/build/ZeroLogic",
      "setup": [
        "setoption name Hash value 4096"
      ],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^tt hits:",
      "quit":   "quit"
    }
  }
}
