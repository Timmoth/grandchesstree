<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Perft is multi-threaded and allocates almost nothing in the hot path;
         ServerGC gives much better multi-core scaling. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Dynamic PGO is on by default in .NET 10 but make it explicit. -->
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>


<PropertyGroup Condition="'$(Release.ToLower())'=='true'">
	<Configuration>Release</Configuration>
	<SelfContained>true</SelfContained>
	<PublishSingleFile>true</PublishSingleFile>
	<PublishTrimmed>true</PublishTrimmed>
	<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	<CETCompat>false</CETCompat>
	<!-- ReadyToRun: precompile to native at publish (cold-start win) while
	     keeping JIT enabled so Dynamic PGO still tiers up the hot path. -->
	<PublishReadyToRun>true</PublishReadyToRun>
	<PublishReadyToRunComposite>true</PublishReadyToRunComposite>
</PropertyGroup>

	
	<ItemGroup>
    <ProjectReference Include="..\GrandChessTree.Shared\GrandChessTree.Shared.csproj" />
  </ItemGroup>

</Project>
