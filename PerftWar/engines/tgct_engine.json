{
  "name": "tgct_engine",
  "version": "0.1.14-r2r",
  "owner": "Timmoth",
  "repo": "https://github.com/Timmoth/grandchesstree",
  "language": "C#",
  "modes": {
    "single-no-cache": {
      "launch": "bin/tgct_engine_local/GrandChessTree.Engine",
      "setup": [],
      "case": "nodes:{depth}:0:{fen}",
      "end_re": "^-{15,}$",
      "quit": "quit"
    },
    "single-with-cache": {
      "launch": "bin/tgct_engine_local/GrandChessTree.Engine",
      "setup": [],
      "case": "nodes:{depth}:4096:{fen}",
      "end_re": "^-{15,}$",
      "quit": "quit"
    },
    "multi-no-cache": {
      "launch": "bin/tgct_engine_local/GrandChessTree.Engine",
      "setup": [],
      "case": "nodes_mt:{depth}:0:{threads}:{fen}",
      "end_re": "^-{15,}$",
      "quit": "quit"
    },
    "multi-with-cache": {
      "launch": "bin/tgct_engine_local/GrandChessTree.Engine",
      "setup": [],
      "case": "nodes_mt:{depth}:4096:{threads}:{fen}",
      "end_re": "^-{15,}$",
      "quit": "quit"
    }
  }
}
